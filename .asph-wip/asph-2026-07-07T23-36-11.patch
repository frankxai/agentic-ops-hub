+    for i, (title, body) in enumerate(rules):
+        accent = [BLUE, VIOLET, EMERALD, GOLD][i]
+        round_rect(d, (82, y, 998, y + 108), fill=(10, 12, 20, 220), outline=rgba(accent, 142), radius=20)
