+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Agentic Coding OS Carousel</title>
+  <style>
+    :root {
+      --bg: #05060A;
+      --surface: #0A0C14;
+      --border: #1A1F2E;
+      --ink: #F1F3F9;
+      --muted: #8A90A8;
+      --accent: #6EA8FE;
+      --accent2: #A78BFA;
+      --proof: #72E6AC;
+      --approval: #F6C86B;
+      --danger: #FF7A90;
+    }
+
+    * { box-sizing: border-box; }
+
+    html, body {
+      margin: 0;
+      background: #111;
+      color: var(--ink);
+      font-family: "Instrument Sans", "Geist", "Segoe UI", system-ui, sans-serif;
+    }
+
+    body {
+      display: grid;
+      gap: 32px;
+      justify-content: center;
+      padding: 32px;
+    }
+
+    .slide {
+      position: relative;
+      width: 1080px;
+      height: 1350px;
+      overflow: hidden;
+      background:
+        radial-gradient(circle at 78% 16%, rgba(110, 168, 254, 0.16), transparent 28%),
+        radial-gradient(circle at 18% 82%, rgba(167, 139, 250, 0.13), transparent 32%),
+        linear-gradient(145deg, #05060A 0%, #07101F 48%, #05060A 100%);
+      border: 1px solid rgba(241, 243, 249, 0.08);
+      page-break-after: always;
+    }
+
+    .slide::before {
+      content: "";
+      position: absolute;
+      inset: 58px;
+      border: 1px solid rgba(241, 243, 249, 0.08);
+      pointer-events: none;
+    }
+
+    .slide::after {
+      content: "";
+      position: absolute;
+      inset: 0;
+      background-image:
+        linear-gradient(rgba(241, 243, 249, 0.035) 1px, transparent 1px),
+        linear-gradient(90deg, rgba(241, 243, 249, 0.035) 1px, transparent 1px);
+      background-size: 72px 72px;
+      mask-image: radial-gradient(circle at center, black, transparent 78%);
+      pointer-events: none;
+    }
+
+    .content {
+      position: relative;
+      z-index: 1;
+      height: 100%;
+      padding: 92px 86px 78px;
+      display: flex;
+      flex-direction: column;
+      justify-content: space-between;
+    }
+
+    .eyebrow {
+      display: inline-flex;
+      width: fit-content;
+      gap: 12px;
+      align-items: center;
+      padding: 12px 16px;
+      border: 1px solid rgba(110, 168, 254, 0.28);
+      background: rgba(10, 12, 20, 0.72);
+      color: var(--accent);
+      font-size: 23px;
+      font-weight: 700;
+      letter-spacing: 0;
+      text-transform: uppercase;
+    }
+
+    h1 {
+      margin: 44px 0 0;
+      font-size: 83px;
+      line-height: 0.96;
+      letter-spacing: 0;
+      max-width: 920px;
+    }
+
+    h2 {
+      margin: 0;
+      font-size: 72px;
+      line-height: 1.02;
+      letter-spacing: 0;
+      max-width: 900px;
+    }
+
