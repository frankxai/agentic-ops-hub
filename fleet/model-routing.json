{
  "version": 2,
  "optimization_objective": "maximize_verified_outcomes_per_wall_clock_hour",
  "night_cap_usd": 110,
  "defaults": {
    "unattended": true,
    "report_root": "fleet/reports/night",
    "receipt_required": true,
    "acceptance_commands_required": true,
    "clean_dedicated_worktree_required": true,
    "max_parallel_per_machine": 1,
    "max_parallel_across_fleet": 2,
    "disk_floor_gb": 50,
    "memory_ceiling_percent": 85
  },
  "daily_planning": {
    "timezone": "Europe/Amsterdam",
    "planning_horizon_hours": 24,
    "replan_interval_minutes": 90,
    "target_usable_capacity_ratio": 0.85,
    "unmeasured_lane_cap": 1,
    "unmetered_lane_cap": 4,
    "default_quota_delta_percent": {
      "maker": 6,
      "verifier": 2,
      "researcher": 3,
      "integrator": 2
    },
    "default_duration_minutes": {
      "maker": 90,
      "verifier": 45,
      "researcher": 60,
      "integrator": 45
    },
    "policy": "Use 85% of capacity above each reserve floor, replan from receipts and resets, and never invent work merely to consume quota."
  },
  "machine_identities": {
    "yoga-book": {"hostnames": ["starlight"]},
    "c940": {"hostnames": ["desktop-1b4icid"]}
  },
  "cli_pools": {
    "codex": {
      "kind": "coding-cli", "quota_pool": "codex", "mode": "measured",
      "machines": ["yoga-book", "c940"], "roles": ["maker", "verifier", "integrator"]
    },
    "claude": {
      "kind": "coding-cli", "quota_pool": "claude", "mode": "measured",
      "machines": ["c940", "yoga-book"], "roles": ["maker", "verifier", "integrator"]
    },
    "gemini": {
      "kind": "long-context-cli", "quota_pool": "gemini", "mode": "measured",
      "machines": ["yoga-book", "c940"], "roles": ["researcher", "verifier"]
    },
    "grok": {
      "kind": "research-and-coding-cli", "quota_pool": "grok", "mode": "measured",
      "machines": ["yoga-book", "c940"], "roles": ["researcher", "verifier", "maker"]
    },
    "agy": {
      "kind": "multi-model-cli", "quota_pool": "agy", "mode": "unmeasured",
      "machines": ["yoga-book", "c940"], "roles": ["maker", "verifier", "researcher"]
    },
    "opencode": {
      "kind": "provider-routing-cli", "quota_pool": "opencode", "mode": "unmeasured",
      "machines": ["yoga-book", "c940"], "roles": ["maker", "verifier"]
    },
    "dcode": {
      "kind": "provider-routing-cli", "quota_pool": "metered-api", "mode": "metered",
      "hard_spend_cap_supported": false,
      "machines": ["yoga-book", "c940"], "roles": ["maker", "verifier", "researcher"]
    },
    "hermes": {
      "kind": "queen-orchestrator", "quota_pool": "orchestration", "mode": "control-only",
      "machines": ["yoga-book"], "roles": ["integrator"]
    }
  },
  "agent_defaults": {
    "claude": {"model": "opus", "max_turns": 30},
    "codex": {"model": "gpt-5.6-terra", "reasoning_effort": "high", "max_turns": 25},
    "opencode": {"model": "github-copilot/gpt-5.4", "max_turns": 20},
    "agy": {"model": "default", "max_turns": 20},
    "gemini": {"model": "gemini-3.5", "max_turns": 15},
    "grok": {"model": "grok-4.5", "max_turns": 20},
    "dcode": {"model": "gpt-5.5", "max_turns": 20}
  },
  "quota_providers": {
    "Claude": "claude",
    "Codex": "codex",
    "Grok Build": "grok"
  },
  "cli_capacity_keys": {
    "claude": "claude-max",
    "codex": "openai-codex-max",
    "gemini": "gemini-ultra",
    "grok": "grok-heavy",
    "agy": "agy",
    "opencode": "opencode",
    "dcode": "dcode-metered"
  },
  "subscription_gates": {
    "claude": {"minimum_remaining_percent": 15, "allow_unmeasured": false},
    "codex": {"minimum_remaining_percent": 15, "allow_unmeasured": false},
    "grok": {"minimum_remaining_percent": 10, "allow_unmeasured": false},
    "opencode": {"mode": "unmetered"},
    "agy": {"allow_unmeasured": true},
    "gemini": {"allow_unmeasured": true},
    "metered-api": {"mode": "metered"},
    "github": {"mode": "unmetered"}
  },
  "subscription_strategy": {
    "principle": "Flat Max/Ultra/Heavy subscriptions are capacity pools. Consume them on bounded deliverables, not duplicated analysis or synthetic token burn.",
    "openai-codex-max": {
      "primary": "implementation, mechanical refactors, independent verification",
      "model": "gpt-5.6-terra",
      "reasoning_effort": "high",
      "machines": ["c940", "yoga-book"]
    },
    "anthropic-claude-max": {
      "primary": "deep multi-file backend implementation and architecture review",
      "model": "opus",
      "fallback_model": "sonnet",
      "machines": ["c940", "yoga-book"]
    },
    "gemini-ultra": {
      "primary": "long-context repository mapping, research synthesis, visual review",
      "model": "gemini-3.5",
      "machines": ["yoga-book", "c940"]
    },
    "xai-heavy": {
      "primary": "Hermes Queen orchestration, adversarial challenge, current web/X research, media",
      "model": "grok-4.5",
      "machines": ["c940", "yoga-book"]
    }
  },
  "routes": {
    "orchestration": {
      "agent": "codex",
      "model": "gpt-5.6-terra",
      "reasoning_effort": "high",
      "budget_usd": 10,
      "max_turns": 10,
      "why": "Codex has healthy live quota; reserve exhausted Grok capacity while Queen keeps owner and conflict judgment"
    },
    "deep-backend": {
      "agent": "claude",
      "model": "opus",
      "budget_usd": 40,
      "max_turns": 30,
      "why": "Deep multi-file backend reasoning and autonomous TDD loops on a single owned worktree"
    },
    "refactor": {
      "agent": "codex",
      "model": "gpt-5.6-terra",
      "reasoning_effort": "high",
      "budget_usd": 30,
      "max_turns": 25,
      "why": "Fast implementation, local verification, and bounded batch fixes"
    },
    "independent-review": {
      "agent": "codex",
      "model": "gpt-5.6-terra",
      "reasoning_effort": "high",
      "budget_usd": 20,
      "max_turns": 15,
      "why": "Second-agent review against tests, diff, security, and integration contract"
    },
    "long-context": {
      "agent": "gemini",
      "model": "gemini-3.5",
      "budget_usd": 15,
      "max_turns": 12,
      "why": "Long-context repository mapping before focused implementation"
    },
    "research": {
      "agent": "grok",
      "model": "grok-4.5",
      "budget_usd": 15,
      "max_turns": 15,
      "why": "Current web/X research and adversarial synthesis, dynamically falling back when the xAI pool is near reserve"
    },
    "low-stakes": {
      "agent": "codex",
      "model": "gpt-5.6-terra",
      "reasoning_effort": "medium",
      "budget_usd": 10,
      "max_turns": 10,
      "why": "Use paid flat subscription capacity for useful small fixes; do not route to an unauthenticated free lane"
    },
    "ui": {
      "agent": "codex",
      "model": "gpt-5.6-terra",
      "reasoning_effort": "high",
      "budget_usd": 30,
      "max_turns": 25,
      "machine": "yoga-book",
      "why": "YogaBook-owned frontend implementation with local browser verification"
    },
    "repo-ops": {
      "agent": "github",
      "model": "deterministic-cli",
      "budget_usd": 2,
      "max_turns": 5,
      "why": "Deterministic issue, PR, CI, and repository operations"
    },
    "infra": {
      "agent": "codex",
      "model": "gpt-5.6-terra",
      "reasoning_effort": "high",
      "budget_usd": 15,
      "max_turns": 15,
      "why": "Healthy Codex quota for gated deterministic infrastructure changes under Queen supervision"
    }
  },
  "fallbacks": {
    "claude": ["codex", "opencode", "agy", "dcode"],
    "codex": ["claude", "agy", "opencode", "dcode"],
    "gemini": ["grok", "codex", "claude", "agy", "dcode"],
    "opencode": ["codex", "claude", "agy", "dcode"],
    "agy": ["codex", "claude", "grok", "opencode", "dcode"],
    "grok": ["gemini", "codex", "claude", "agy", "dcode"],
    "dcode": ["codex", "claude", "agy", "opencode"],
    "cursor": ["codex"],
    "github": ["hermes"],
    "hermes": ["codex"]
  },
  "completion_contract": {
    "states": ["queued", "claimed", "artifact-produced", "tested", "integrated", "verified", "delivered"],
    "done_requires": ["receipt", "commit", "zero-exit acceptance commands", "integration_state", "completed_at"],
    "report_only_is_done": false,
    "configured_cron_is_outcome": false
  }
}
