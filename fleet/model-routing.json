{
  "version": 5,
  "pacing": {
    "rule_precedence": [
      "expiring_first",
      "claude_pacing",
      "codex_floor"
    ],
    "rule_precedence_scope": "Apply routing preferences in listed order among eligible work only; Claude over-target restrictions and the Fable cutoff remain mandatory.",
    "expiring_first": {
      "minimum_remaining_percent": 30,
      "reset_within_hours": 24,
      "action": "Route all eligible work classes to the qualifying subscription first."
    },
    "claude_pacing": {
      "weekly_window_start": "Sunday 04:00 UTC",
      "days_elapsed": "floor((now_utc - most_recent_Sunday_04_00_UTC) / 24_hours)",
      "percent_per_elapsed_day": 15,
      "cap_percent": 100,
      "weekly_target_used_percent": "min(cap_percent, percent_per_elapsed_day * (days_elapsed + 1))",
      "over_target": {
        "allowed_work_classes": [
          "architecture",
          "security",
          "long-instruction"
        ],
        "fable_opus_named_ticket_required": true,
        "fan_out_moves_to": [
          "grok",
          "codex"
        ]
      },
      "fable_disable_at_used_percent": 80,
      "fable_disabled_until": "reset"
    },
    "codex_floor": {
      "weekly_minimum_used_percent": "min(cap_percent, percent_per_elapsed_day * (days_elapsed + 1))",
      "below_floor_default_work_classes": [
        "implement",
        "refactor"
      ],
      "below_floor_default_agent": "codex",
      "weekly_window_start": "current window start in UTC = the Codex/Weekly `resets_at` reported by `tokscale usage --json` minus 168 hours (tokscale reports the UPCOMING reset); Codex's window is not Sunday 04:00 UTC like Claude's",
      "percent_per_elapsed_day": 10,
      "cap_percent": 100,
      "days_elapsed": "floor((now_utc - weekly_window_start) / 24 hours)"
    }
  },
  "on_demand_api_worker": {
    "all_conditions_required": true,
    "subscription_exhaustion": {
      "scope": "every eligible subscription for the job class",
      "minimum_used_percent": 95,
      "alternative": "rate-limited until after the job deadline"
    },
    "job": {
      "criticality_any_of": [
        "revenue-critical",
        "production-critical"
      ],
      "named_ticket_required": true,
      "deadline_before_reset_required": true
    },
    "budget": {
      "monthly_envelope_eur": 499,
      "condition": "envelope_fit or frank_approval_recorded",
      "envelope_fit": "Month-to-date spend plus the worker cap must fit the monthly envelope.",
      "envelope_fit_waived_by": "frank_approval_recorded",
      "waiver_scope": [
        "envelope_fit"
      ],
      "measured_on": "2026-09-15",
      "fixed_plan_costs_exceed_envelope": true,
      "over_envelope_exception": "Recorded explicit approval by Frank waives only envelope fit; subscription exhaustion, job requirements, capped OpenRouter key, all execution caps, receipts, and never_for exclusions remain mandatory."
    },
    "execution": {
      "provider": "openrouter",
      "capped_key_required": true,
      "max_usd_per_job": 20,
      "max_usd_per_week": 50,
      "max_concurrent_workers": 1,
      "receipt_required": true,
      "receipt_directory": "fleet/reports/agents/"
    },
    "never_for": [
      "convenience",
      "docs",
      "research",
      "cron"
    ]
  },
  "optimization_objective": "maximize_verified_outcomes_per_wall_clock_hour",
  "night_cap_usd": 110,
  "defaults": {
    "unattended": true,
    "report_root": "C:/Users/frank/agentic-ops/fleet/reports/night",
    "receipt_required": true,
    "acceptance_commands_required": true,
    "clean_dedicated_worktree_required": true,
    "max_parallel_per_machine": 1,
    "max_parallel_across_fleet": 2,
    "disk_floor_gb": 50,
    "memory_ceiling_percent": 85
  },
  "subscription_strategy": {
    "principle": "Flat Max/Ultra/Heavy subscriptions are capacity pools. Consume them on bounded deliverables, not duplicated analysis or synthetic token burn.",
    "openai-codex-max": {
      "primary": "implementation, mechanical refactors, independent verification",
      "model": "gpt-5.6-terra",
      "reasoning_effort": "high",
      "machines": [
        "c940",
        "yoga-book"
      ]
    },
    "anthropic-claude-max": {
      "primary": "deep multi-file backend implementation and architecture review",
      "model": "opus",
      "fallback_model": "sonnet",
      "machines": [
        "c940",
        "yoga-book"
      ]
    },
    "gemini-ultra": {
      "primary": "long-context repository mapping, research synthesis, visual review",
      "model": "gemini-3.5",
      "machines": [
        "yoga-book",
        "c940"
      ]
    },
    "xai-heavy": {
      "primary": "Hermes Queen orchestration, adversarial challenge, current web/X research, media",
      "model": "grok-4.5",
      "machines": [
        "c940",
        "yoga-book"
      ]
    }
  },
  "routes": {
    "orchestration": {
      "agent": "hermes",
      "model": "grok-4.5",
      "budget_usd": 10,
      "max_turns": 10,
      "why": "Queen judgment, owner assignment, conflict resolution, and concise delivery reporting"
    },
    "deep-backend": {
      "agent": "claude",
      "model": "opus",
      "budget_usd": 40,
      "max_turns": 30,
      "why": "Deep multi-file backend reasoning and autonomous TDD loops on a single owned worktree"
    },
    "refactor": {
      "agent": "codex",
      "model": "gpt-5.6-terra",
      "reasoning_effort": "high",
      "budget_usd": 30,
      "max_turns": 25,
      "why": "Fast implementation, local verification, and bounded batch fixes"
    },
    "independent-review": {
      "agent": "codex",
      "model": "gpt-5.6-terra",
      "reasoning_effort": "high",
      "budget_usd": 20,
      "max_turns": 15,
      "why": "Second-agent review against tests, diff, security, and integration contract"
    },
    "long-context": {
      "agent": "gemini",
      "model": "gemini-3.5",
      "budget_usd": 15,
      "max_turns": 12,
      "why": "Long-context repository mapping before focused implementation"
    },
    "research": {
      "agent": "hermes",
      "model": "grok-4.5",
      "budget_usd": 15,
      "max_turns": 15,
      "why": "Current web/X research and adversarial synthesis with citations"
    },
    "low-stakes": {
      "agent": "codex",
      "model": "gpt-5.6-terra",
      "reasoning_effort": "medium",
      "budget_usd": 10,
      "max_turns": 10,
      "why": "Use paid flat subscription capacity for useful small fixes; do not route to an unauthenticated free lane"
    },
    "ui": {
      "agent": "codex",
      "model": "gpt-5.6-terra",
      "reasoning_effort": "high",
      "budget_usd": 30,
      "max_turns": 25,
      "machine": "yoga-book",
      "why": "YogaBook-owned frontend implementation with local browser verification"
    },
    "repo-ops": {
      "agent": "github",
      "model": "deterministic-cli",
      "budget_usd": 2,
      "max_turns": 5,
      "why": "Deterministic issue, PR, CI, and repository operations"
    },
    "infra": {
      "agent": "hermes",
      "model": "grok-4.5",
      "budget_usd": 15,
      "max_turns": 15,
      "why": "Queen plus domain skills for gated infrastructure operations"
    }
  },
  "fallbacks": {
    "claude": [
      "codex",
      "hermes"
    ],
    "codex": [
      "claude",
      "hermes"
    ],
    "gemini": [
      "claude",
      "codex"
    ],
    "opencode": [
      "codex"
    ],
    "cursor": [
      "codex"
    ],
    "github": [
      "hermes"
    ],
    "hermes": [
      "codex"
    ]
  },
  "completion_contract": {
    "states": [
      "queued",
      "claimed",
      "artifact-produced",
      "tested",
      "integrated",
      "verified",
      "delivered"
    ],
    "done_requires": [
      "receipt",
      "commit",
      "zero-exit acceptance commands",
      "integration_state",
      "completed_at"
    ],
    "report_only_is_done": false,
    "configured_cron_is_outcome": false
  }
}
