{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/frankxai/agentic-ops-hub/blob/main/fleet/schemas/task-contract.v1.schema.json",
  "title": "Fleet Task Contract v1",
  "description": "A Git-backed, machine-owned lease for bounded fleet work. Validation does not authorize side effects.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "task_id",
    "title",
    "description",
    "issuer",
    "issued_at",
    "machine_owner",
    "repo_path_allowlist",
    "resource_budget",
    "expiry",
    "done_condition",
    "priority",
    "constraints",
    "source",
    "execution_status",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "task_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 240 },
    "description": { "type": "string", "minLength": 1 },
    "issuer": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "issued_at": { "type": "string", "format": "date-time" },
    "machine_owner": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "repo_path_allowlist": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      }
    },
    "resource_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_tokens", "max_minutes", "max_cost_usd", "models_allowed"],
      "properties": {
        "max_tokens": { "type": "integer", "minimum": 0 },
        "max_minutes": { "type": "integer", "minimum": 0 },
        "max_cost_usd": { "type": "number", "minimum": 0 },
        "models_allowed": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "expiry": { "type": "string", "format": "date-time" },
    "done_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "conditions"],
      "properties": {
        "type": { "enum": ["and", "or"] },
        "conditions": { "type": "array", "minItems": 1, "items": { "type": "object", "minProperties": 1 } }
      }
    },
    "priority": { "type": "string", "pattern": "^P[0-9]+$" },
    "constraints": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "source": { "type": "string", "minLength": 1 },
    "execution_status": { "enum": ["issued", "claimed", "running", "completed", "expired", "cancelled"] },
    "outcome_status": { "type": ["string", "null"] },
    "claimed_by": { "type": ["string", "null"] },
    "claimed_at": { "type": ["string", "null"], "format": "date-time" },
    "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
